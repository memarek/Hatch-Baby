# Copy to .env and fill in. Never commit .env.

# Hatch app login (same as the Hatch Sleep app)
HATCH_EMAIL=you@example.com
HATCH_PASSWORD=your-hatch-password
# Optional: part of the Hatch device name, if you have more than one
HATCH_DEVICE=
# Nightlight color (hex) and brightness (0-100) used by `play`
HATCH_COLOR=ff6a00
HATCH_BRIGHTNESS=20

# Spotify app from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Name (or part of it) of the Spotify Connect speaker in the nursery
SPOTIFY_SPEAKER=Nursery Echo
# Playlist used when `play` is run without one
SPOTIFY_DEFAULT_URI=spotify:playlist:37i9dQZF1DWZd79rJ6a7lp

# ---- Web UI (hatch_ui.py) ----
# Required whenever anything but this computer can reach the UI. 12+ characters.
UI_PASSWORD=
# Where the UI listens. Keep 127.0.0.1 behind Tailscale; 0.0.0.0 opens it to your Wi-Fi.
UI_HOST=127.0.0.1
UI_PORT=8888
# Set both when serving over HTTPS (deploy/setup.sh fills these in):
# UI_PUBLIC_URL=https://bedtime.your-tailnet.ts.net
# UI_SECURE_COOKIES=1
